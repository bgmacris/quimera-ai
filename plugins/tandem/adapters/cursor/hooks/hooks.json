      {
        "matcher": "MCP:browser_navigate_back",
        "command": "./scripts/run-session-hook.sh touch"
      },
      {
        "matcher": "MCP:browser_network_request",
        "command": "./scripts/run-session-hook.sh touch"
      },
      {
        "matcher": "MCP:browser_network_requests",
        "command": "./scripts/run-session-hook.sh touch"
