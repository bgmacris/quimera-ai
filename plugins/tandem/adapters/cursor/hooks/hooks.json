      },
      {
        "matcher": "MCP:browser_emulate_media",
        "command": "./scripts/run-session-hook.sh touch"
      },
      {
        "matcher": "MCP:browser_evaluate",
        "command": "./scripts/run-session-hook.sh touch"
      },
      {
        "matcher": "MCP:browser_file_upload",
        "command": "./scripts/run-session-hook.sh touch"
