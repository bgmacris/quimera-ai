      },
      {
        "matcher": "MCP:browser_tabs",
        "command": "./scripts/run-session-hook.sh touch"
      },
      {
        "matcher": "MCP:browser_take_screenshot",
        "command": "./scripts/run-session-hook.sh touch"
      },
      {
        "matcher": "MCP:browser_type",
